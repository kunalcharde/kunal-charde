# Contact form delivery (https://web3forms.com — free, sends submissions to your inbox).
# Create an access key for kunalcharde1@gmail.com, then copy this file to .env.local and paste it below.
# Without a key, the form falls back to opening the visitor's email client with the message pre-filled.
VITE_WEB3FORMS_KEY=

# Optional: the client pipeline's enquiry endpoint. Each enquiry also becomes a lead there.
# The pipeline must list this site's address in its INBOUND_ALLOWED_ORIGINS.
VITE_PIPELINE_ENQUIRY_URL=""
